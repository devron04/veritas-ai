# ========================
# Veritas AI — .gitignore
# ========================

# ---------- Python / Backend ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables (SECRETS!)
.env
.env.*
!.env.example

# Database files
*.db
*.sqlite3

# Model cache (large files)
sentence_transformers_cache/

# ---------- Node / Frontend ----------
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---------- IDE / Editor ----------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ---------- OS ----------
*.tmp
*.bak
*.swp
*~

# ---------- Misc ----------
.agents/
*.log

# ---------- Admin / Migration Scripts ----------
backend/make_admin.py
backend/migrate_add_columns.py
